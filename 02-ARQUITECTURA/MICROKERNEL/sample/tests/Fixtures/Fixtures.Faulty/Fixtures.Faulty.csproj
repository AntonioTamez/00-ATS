<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Copies the plugin's own dependencies next to it and produces the .deps.json the kernel's resolver reads. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <PluginStage>fixtures</PluginStage>
  </PropertyGroup>

  <ItemGroup>
    <!-- The contracts are SHARED with the host. Private=false: do not copy Shipping.Contracts.dll next to the plugin. -->
    <ProjectReference Include="..\..\..\src\Shipping.Contracts\Shipping.Contracts.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
