<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shipping.Contracts\Shipping.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Shipping.Kernel\Shipping.Kernel.csproj" />

    <!--
      The tests do NOT reference the plugins' code. They only make sure the plugins are BUILT (and staged into artifacts/)
      before the tests run, exactly like a deployment would do. ReferenceOutputAssembly=false keeps them out of the test's references.
    -->
    <ProjectReference Include="..\..\src\plugins\Carriers.Standard\Carriers.Standard.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\plugins\Carriers.Express\Carriers.Express.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Fixtures.Faulty\Fixtures.Faulty.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Fixtures.Impostor\Fixtures.Impostor.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Fixtures.FutureContract\Fixtures.FutureContract.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Fixtures.StandardClone\Fixtures.StandardClone.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Fixtures.NotAPlugin\Fixtures.NotAPlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Fixtures.BundledContracts\Fixtures.BundledContracts.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
