<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The CONTRACT between the kernel and every plugin. It is the only assembly both sides know.
    It references nothing but the framework, and it has to stay small and stable: every plugin ever written depends on it.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
