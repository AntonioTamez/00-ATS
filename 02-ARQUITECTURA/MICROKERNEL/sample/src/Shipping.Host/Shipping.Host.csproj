<Project Sdk="Microsoft.NET.Sdk">

  <!-- The application. It references the kernel and the contracts, never a plugin: plugins are found at run time. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shipping.Contracts\Shipping.Contracts.csproj" />
    <ProjectReference Include="..\Shipping.Kernel\Shipping.Kernel.csproj" />
  </ItemGroup>

</Project>
